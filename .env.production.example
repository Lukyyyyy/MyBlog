# This file documents /etc/myblog/myblog.env.
# Never copy real production values into the repository.

MONGO_INITDB_ROOT_USERNAME=myblog_root
MONGO_INITDB_ROOT_PASSWORD=<openssl-rand-hex-32>
MONGO_APP_DATABASE=lukybetter
MONGO_APP_USERNAME=myblog_app
MONGO_APP_PASSWORD=<openssl-rand-hex-32>

DATABASE_URL=mongodb://myblog_app:<mongo-app-password>@mongo:27017/lukybetter?authSource=lukybetter
BUILD_DATABASE_URL=mongodb://myblog_app:<mongo-app-password>@127.0.0.1:27017/lukybetter?authSource=lukybetter

PAYLOAD_SECRET=<openssl-rand-hex-32>
CRON_SECRET=<openssl-rand-hex-32>
PREVIEW_SECRET=<openssl-rand-hex-32>
